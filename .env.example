# Copy this file to ".env" (Windows: copy .env.example .env) and change the secret.
PORT=3000
# Any long random text, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-text
NODE_ENV=development
# ---- DATABASE ----
# The app saves everything (products, users, orders) in MySQL when MYSQL_HOST is set.
DB_CLIENT=mysql
# XAMPP default: user root with an EMPTY password. Use 127.0.0.1 (not localhost) on Windows.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=techmart
# Azure Database for MySQL needs SSL: set to true (or no-verify if the certificate check fails)
# MYSQL_SSL=true
# Leave DB_CLIENT=mysql. (DB_CLIENT=sqlite would use a local file instead of XAMPP.)

# Optional email notifications (leave blank to disable; in-app notifications still work)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Only used by the optional one-time copy: npm run migrate:mysql
SQLITE_FILE=./data/shop.db
