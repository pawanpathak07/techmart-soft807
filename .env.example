# Copy this file to ".env" (Windows: copy .env.example .env) and change the secret.
PORT=3000
# Any long random text, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-text
NODE_ENV=development
# Optional: custom SQLite database file location
# DB_FILE=./data/shop.db

# Optional email notifications (leave blank to disable; in-app notifications still work)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: only used by "npm run migrate:mysql" (copies SQLite data into a MySQL database)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=techmart
SQLITE_FILE=./data/shop.db
